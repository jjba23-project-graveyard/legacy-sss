@node Screenshot keybindings
@section Screenshot keybindings

@multitable {aaaaaaa} {aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}
@headitem keybind
@tab command
@item @code{s-S-.}
@tab @strong{Copy} screenshot of entire screen
@item @code{s-.}
@tab @strong{Save} screenshot of entire screen
@item @code{s-k}
@tab Kill/Close a window or application
@item @code{s-S-c}
@tab Reload Sway configuration
@end multitable

@node Application keybindings
@section Application keybindings

@multitable {aaaaaaa} {aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}
@headitem keybind
@tab command
@item @code{s-/}
@tab Launch application fuzzy finder menu
@item @code{s-i}
@tab Open a Web Browser (Qutebrowser)
@item @code{s-S-i}
@tab Open a bloated Web Browser (Chrome)
@item @code{s-RET}
@tab Open a terminal emulator (Foot)
@item @code{s-t}
@tab @emph{idem}
@item @code{s-e}
@tab Open text editor (Emacs)
@item @code{s--}
@tab Open password manager (1password)
@item 
@tab 
